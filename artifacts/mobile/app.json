{
  "expo": {
    "name": "AMY モバイル",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "jp.amy.kanri",
      "buildNumber": "26",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "施工現場の進捗写真および経費の領収書を撮影するためにカメラを使用します。撮影した写真は案件の進捗報告や経費申請に添付されます。",
        "NSPhotoLibraryUsageDescription": "施工現場の進捗写真および経費の領収書を写真ライブラリから選択するために使用します。選択した写真は案件の進捗報告や経費申請に添付されます。",
        "NSPhotoLibraryAddUsageDescription": "撮影した施工現場の写真を写真ライブラリに保存するために使用します。"
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true },
              { "name": "AppCheckCore", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6110a7fc-f2fe-4e8f-99ec-2a0994133bad"
      }
    }
  }
}
